{
  "$comment": "AI apps AI RAM Guard knows. Add yours with a pull request: see docs/adding-an-agent.md",
  "helperPatterns": [
    "\\bmcp\\b",
    "mcp-server",
    "@modelcontextprotocol/",
    "npx-cli\\.js",
    "\\buvx?\\b.*\\bmcp",
    "desktop-commander",
    "server\\.mjs"
  ],
  "shareable": [
    {
      "$comment": "Stateless over HTTP: every request stands alone, so sessions sharing one copy stay apart. Needs a token and listens on 127.0.0.1 only. AI RAM Guard checks that it answers several requests before it changes a config.",
      "match": "email-mcp",
      "stdioArg": "stdio",
      "httpArgs": ["http", "--port", "{port}"],
      "tokenEnv": "EMAIL_MCP_HTTP_TOKEN",
      "path": "/mcp"
    }
  ],
  "agents": [
    {
      "id": "claude",
      "name": "Claude (Desktop / Code)",
      "processNames": ["claude"],
      "helperPatterns": []
    },
    {
      "id": "codex",
      "name": "OpenAI Codex / ChatGPT",
      "processNames": ["codex", "ChatGPT"],
      "helperPatterns": ["cua-repl", "codex-app-tools", "node_repl"]
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "processNames": ["Cursor"],
      "helperPatterns": []
    },
    {
      "id": "windsurf",
      "name": "Windsurf",
      "processNames": ["Windsurf"],
      "helperPatterns": []
    },
    {
      "id": "vscode",
      "name": "VS Code (Copilot / agents)",
      "processNames": ["Code", "Code - Insiders"],
      "helperPatterns": []
    },
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "processNames": [],
      "cliPatterns": ["@google[\\\\/]gemini-cli", "gemini-cli"],
      "helperPatterns": []
    },
    {
      "id": "grok",
      "name": "Grok",
      "processNames": ["Grok", "Grok Bot"],
      "helperPatterns": []
    },
    {
      "id": "lmstudio",
      "name": "LM Studio",
      "processNames": ["LM Studio"],
      "helperPatterns": []
    },
    {
      "id": "ollama",
      "name": "Ollama",
      "processNames": ["ollama", "ollama app"],
      "helperPatterns": []
    }
  ]
}
