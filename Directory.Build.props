<Project>
  <PropertyGroup>
    <Version>1.2.1</Version>
    <Authors>Magnus Steinmeier Olsen</Authors>
    <Company>Byens IT</Company>
    <Product>AI RAM Guard</Product>
    <Copyright>© 2026 Magnus Steinmeier Olsen / Byens IT</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/byensitmagnus/ai-ram-guard</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A trimmed publish (the CLI) also builds Core with the trim analyzer on. Partial trim keeps app code whole, so its JSON reflection is safe. -->
    <SuppressTrimAnalysisWarnings Condition="'$(PublishTrimmed)' == 'true'">true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
</Project>
